<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.0" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd">
    <servlet>
        <servlet-name>ControllerInitialization</servlet-name>
        <servlet-class>controllers.ControllerInitialization</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ControllerAdministration</servlet-name>
        <servlet-class>controllers.ControllerAdministration</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>NewServlet</servlet-name>
        <servlet-class>NewServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ControllerLogin</servlet-name>
        <servlet-class>controllers.ControllerLogin</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ControllerLibrary</servlet-name>
        <servlet-class>controllers.ControllerLibrary</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ControllerInitialization</servlet-name>
        <url-pattern>/ControllerInitialization</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ControllerAdministration</servlet-name>
        <url-pattern>/ControllerAdministration</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>NewServlet</servlet-name>
        <url-pattern>/NewServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ControllerLogin</servlet-name>
        <url-pattern>/ControllerLogin</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ControllerLibrary</servlet-name>
        <url-pattern>/ControllerLibrary</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
